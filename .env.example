# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OLLAMA_BASE_URL: Local Open-Source AI runtime endpoint (e.g., http://localhost:11434)
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Configurable Independent Models
MODEL_A_NAME="llama3:latest"
MODEL_B_NAME="mistral:latest"

# Optional Cloud Sync (Disabled by default, local IndexedDB is primary)
MONGODB_URI="mongodb://localhost:27017/veritycare"
JWT_SECRET="veritycare_secure_local_dev_secret"

# Permitted Healthcare Directory & Medical Sources API keys (optional)
PUBMED_API_KEY=""
DOCTOR_DIRECTORY_API_KEY=""
